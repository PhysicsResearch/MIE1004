---
// All lab pages on one page, in the order of src/outline.mjs.
// `npm run pdf` prints this page to the downloadable PDF.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getEntry, render } from 'astro:content';
import { chapters, labTitle, sidePages, siteUrl } from '../outline.mjs';

async function load(id: string) {
	const entry = await getEntry('docs', id);
	if (!entry) throw new Error(`print page: no page "${id}" in src/content/docs (check src/outline.mjs)`);
	const { Content } = await render(entry);
	return { id, title: entry.data.title, Content };
}

// Each section is followed by its side pages (help pages that are not in the sidebar).
const withSidePages = (ids: string[]) =>
	ids.flatMap((id) => [id, ...((sidePages as Record<string, string[]>)[id] ?? [])]);

const overview = await load('index');
const parts = await Promise.all(
	chapters.map(async (chapter) => ({
		intro: await load(chapter.intro),
		sections: await Promise.all(withSidePages(chapter.sections).map(load)),
	}))
);
const date = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const siteLabel = siteUrl.replace(/^https?:\/\//, '');
---

<StarlightPage
	frontmatter={{ title: labTitle, tableOfContents: false, pagefind: false, prev: false, next: false }}
	hasSidebar={false}
>
	<div class="print-doc" data-site={siteUrl}>
		<div class="print-cover">
			<p class="print-course">MIE1004 · Data Management Practical</p>
			<p class="print-date">Version of {date}</p>

			<div class="print-site-note">
				<p class="print-site-label">Follow the instructions on the website</p>
				<p class="print-site-url"><a href={siteUrl}>{siteLabel}</a></p>
				<p>
					This PDF is additional material and a backup, for example to read offline or to print. The
					website is always the most up-to-date version, and it has the downloads and links you need
					during the lab.
				</p>
			</div>

			<p class="print-contents-title">Contents</p>
			<ul class="print-contents">
				<li>Overview</li>
				{
					parts.map(({ intro, sections }) => (
						<li>
							{intro.title}
							{sections.length > 0 && (
								<ul>
									{sections.map(({ title }) => (
										<li>{title}</li>
									))}
								</ul>
							)}
						</li>
					))
				}
			</ul>
		</div>

		<section class="chapter">
			<h2 class="chapter-title">Overview</h2>
			<overview.Content />
		</section>
		{
			parts.map(({ intro, sections }) => (
				<section class="chapter">
					<h2 class="chapter-title">{intro.title}</h2>
					<intro.Content />
					{sections.map(({ title, Content }) => (
						<section class="section">
							<h3 class="section-title">{title}</h3>
							<Content />
						</section>
					))}
				</section>
			))
		}
	</div>
</StarlightPage>

<script>
	// A PDF can't be clicked open, so show the content of click-to-open boxes.
	document.querySelectorAll<HTMLDetailsElement>('.print-doc details').forEach((box) => {
		box.open = true;
	});

	// Links between pages of the site point to the published website in the PDF.
	const site = document.querySelector<HTMLElement>('.print-doc')?.dataset.site ?? '';
	document.querySelectorAll<HTMLAnchorElement>('.print-doc a[href^="/"]').forEach((link) => {
		if (site) link.href = site + link.getAttribute('href');
		else link.removeAttribute('href');
	});

	// Images are loaded lazily on the website; load them all now so they appear in the PDF.
	document.querySelectorAll<HTMLImageElement>('.print-doc img').forEach((img) => {
		img.loading = 'eager';
	});
</script>
